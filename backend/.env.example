PORT=4000
BIND_HOST=127.0.0.1
DATABASE_PATH=./data/brightloop.sqlite
FRONTEND_URL=http://localhost:5173
CURRENCY=INR
NODE_ENV=development
# Use 1 only when all requests arrive through exactly one trusted reverse proxy.
TRUST_PROXY=0
# Initial admin is created only if no admin exists. Use a unique strong password.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
# ADMIN_NAME=Administrator
# Production requires SMTP. Development without SMTP keeps email in admin-only outbox.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Brightloop <billing@example.com>
