{
  "name": "brightloop-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env src/seed.js",
    "billing": "node --env-file-if-exists=.env src/run-billing.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "express": "^5.1.0",
    "nodemailer": "^10.3.1"
  }
}
